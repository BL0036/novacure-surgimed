// NovaCure Surgimed Suppliers — Phase 1: product master data schema
// Multi-brand healthcare e-commerce platform. First brand: Craftscare (orthopaedic products, Nepal).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Brand — a storefront brand on the multi-brand platform (e.g. Craftscare).
// ---------------------------------------------------------------------------
model Brand {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  logo        String?
  description String?

  categories Category[]
  products   Product[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("brands")
}

// ---------------------------------------------------------------------------
// Category — hierarchical, scoped to a single brand (self-referencing tree).
// ---------------------------------------------------------------------------
model Category {
  id       String  @id @default(cuid())
  name     String
  slug     String
  brandId  String  @map("brand_id")
  brand    Brand   @relation(fields: [brandId], references: [id], onDelete: Cascade)

  parentCategoryId String?    @map("parent_category_id")
  parentCategory   Category?  @relation("CategoryToSubcategory", fields: [parentCategoryId], references: [id], onDelete: Restrict)
  subCategories    Category[] @relation("CategoryToSubcategory")

  products Product[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // A slug only needs to be unique within a brand, not globally.
  @@unique([brandId, slug])
  @@index([parentCategoryId])
  @@map("categories")
}

enum ProductStatus {
  draft
  needs_verification
  verified
  published
}

enum PublicationStatus {
  unpublished
  published
}

// ---------------------------------------------------------------------------
// Product — one catalogue product. Size/price/SKU detail lives on
// ProductVariant, since the source catalogue is priced per size.
// ---------------------------------------------------------------------------
model Product {
  id       String @id @default(cuid())
  brandId  String @map("brand_id")
  brand    Brand  @relation(fields: [brandId], references: [id], onDelete: Cascade)

  categoryId String   @map("category_id")
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  name               String
  rawCatalogueName   String  @map("raw_catalogue_name")
  manufacturerRefCode String? @map("manufacturer_ref_code")
  slug               String  @unique

  shortDescription String? @map("short_description")
  fullDescription  String? @map("full_description")
  features         String?

  hsCode String? @map("hs_code")

  status            ProductStatus      @default(draft)
  publicationStatus PublicationStatus  @default(unpublished) @map("publication_status")

  seoTitle       String? @map("seo_title")
  seoDescription String? @map("seo_description")
  seoKeywords    String? @map("seo_keywords")

  variants          ProductVariant[]
  images            ProductImage[]
  verificationFlags VerificationFlag[]
  enquiries         Enquiry[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([brandId])
  @@index([categoryId])
  @@index([status])
  @@map("products")
}

enum VatStatus {
  VAT
  NON_VAT
}

enum StockStatus {
  in_stock
  out_of_stock
  discontinued
  unknown
}

// ---------------------------------------------------------------------------
// ProductVariant — one sellable unit of a Product (a size, or a pack size
// for consumables). One row per CSV import row.
// ---------------------------------------------------------------------------
model ProductVariant {
  id        String  @id @default(cuid())
  productId String  @map("product_id")
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  sizeLabel String @map("size_label")
  sku       String @unique
  uom       String

  // Phase 9 — most variants share the product-level manufacturerRefCode,
  // but some products print a different ref code per size tier on the
  // packaging (e.g. Lumbar Sacro Belt: A-513 for S/M/L/XL, B-513 for
  // XXL). Nullable: falls back to Product.manufacturerRefCode when unset.
  manufacturerRefCode String? @map("manufacturer_ref_code")

  // Internal cost price — never expose outside the database/service layer.
  // Nullable: a handful of source rows have no stockist rate or retail price
  // yet (see VerificationFlag "missing_price" on the product).
  stockistRate Decimal? @map("stockist_rate") @db.Decimal(10, 2)
  retailPrice  Decimal? @map("retail_price") @db.Decimal(10, 2)
  mrp          Decimal  @db.Decimal(10, 2)

  vatStatus   VatStatus   @map("vat_status")
  stockStatus StockStatus @default(unknown) @map("stock_status")

  // Free-form measurement detail (dimensions, weight, size-chart data, etc.)
  // that doesn't warrant its own column and varies by product type.
  measurementData Json? @map("measurement_data")

  enquiries Enquiry[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([productId])
  @@map("product_variants")
}

enum ProductImageType {
  primary
  secondary
  detail
  packaging
  size_guide
}

enum ImageSource {
  catalogue_scan
  manufacturer
  own_photograph
  ai_cleaned
}

enum ImageStatus {
  pending
  available
}

// ---------------------------------------------------------------------------
// ProductImage — image assets for a product. Phase 1 stores rows with
// image_status = pending for products with no photo yet (see CSV notes).
// ---------------------------------------------------------------------------
model ProductImage {
  id        String  @id @default(cuid())
  productId String  @map("product_id")
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  type ProductImageType

  originalPath  String? @map("original_path")
  webPath       String? @map("web_path")
  thumbnailPath String? @map("thumbnail_path")

  source ImageSource

  altText String? @map("alt_text")

  imageStatus ImageStatus @default(pending) @map("image_status")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([productId])
  @@map("product_images")
}

// ---------------------------------------------------------------------------
// VerificationFlag — data-quality issues surfaced during import/review,
// e.g. price discrepancies between merged catalogue rows, missing ref
// codes, missing photos. Resolved by an admin later (Phase 7).
// ---------------------------------------------------------------------------
model VerificationFlag {
  id        String  @id @default(cuid())
  productId String  @map("product_id")
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  issueType String  @map("issue_type")
  // Original issue description, written by the Phase 1 import script.
  // Never overwritten by the admin — see resolutionNote below.
  note      String?
  resolved  Boolean @default(false)

  // The admin's own note explaining how/why this was resolved, kept
  // separate from the import-generated `note` above so the original
  // issue description is never lost.
  resolutionNote String?   @map("resolution_note")
  resolvedAt     DateTime? @map("resolved_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([productId])
  @@index([resolved])
  @@map("verification_flags")
}

// ---------------------------------------------------------------------------
// AdminUser / AdminSession — Phase 7 admin authentication. Single admin
// role only (no permissions/roles system) — see README "Phase 7
// decisions" for why this is a real table rather than one hardcoded
// env-var login. Passwords are bcrypt hashes, never plaintext.
// ---------------------------------------------------------------------------
model AdminUser {
  id           String @id @default(cuid())
  email        String @unique
  passwordHash String @map("password_hash")

  sessions AdminSession[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("admin_users")
}

// Sessions store a SHA-256 hash of the session token, never the token
// itself — the raw token only ever exists in the httpOnly cookie and in
// memory at login time, the same way passwordHash never stores the
// plaintext password.
model AdminSession {
  id          String    @id @default(cuid())
  adminUserId String    @map("admin_user_id")
  adminUser   AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([adminUserId])
  @@map("admin_sessions")
}

// ---------------------------------------------------------------------------
// Enquiry — Phase 11. A customer/hospital enquiry captured from the
// "Order via WhatsApp" / "Request this product" CTAs on a product page, or
// the general enquiry form on /for-hospitals-pharmacies. No cart, no
// payment integration, no customer accounts — this is the entire order
// pipeline for this phase: a lead an admin follows up on by hand (phone/
// WhatsApp), tracked through `status` here.
// ---------------------------------------------------------------------------
enum EnquiryStatus {
  new
  contacted
  confirmed
  fulfilled
  cancelled
}

model Enquiry {
  id String @id @default(cuid())

  // Both nullable: a hospital/pharmacy enquiry from the general form isn't
  // tied to one product. Set null (not cascade-deleted) if the product or
  // variant it referenced is later removed — the enquiry is a customer
  // record that should outlive the catalogue row.
  productId String?  @map("product_id")
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  variantId String?         @map("variant_id")
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  customerName     String  @map("customer_name")
  phone            String
  email            String?
  organizationName String? @map("organization_name")
  addressOrArea    String  @map("address_or_area")
  quantity         Int     @default(1)
  message          String?

  status EnquiryStatus @default(new)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([productId])
  @@index([status])
  @@index([createdAt])
  @@map("enquiries")
}

